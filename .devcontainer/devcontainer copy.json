//devcontainer.json
{
  "name": "Confluent-Cloud-Metrics-Prometheus",
  "build": {
    "dockerfile": "Dockerfile"
  },
//  "workspaceFolder": "/workspace",
//  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  // Explicitly bind mount the local workspace folder to /workspace in the container

  // Tell VS Code to open the /workspace folder inside the container
  // Automatically mounts the current folder to /workspace
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "configureZshAsDefaultShell": true
    }
  },
  // Mounts the top-level parent directory directly to /workspaces
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/confluent-cloud-metrics-prometheus,type=bind,consistency=cached",

  // Tell VS Code to open the workspace file itself inside the container
//  "workspaceFolder": "/workspaces/confluent-cloud-metrics-prometheus.code-workspace",
  "workspaceFolder": "/workspaces/confluent-cloud-metrics-prometheus/confluent-cloud-metrics-prometheus.code-workspace",
  // Disable copying the host's Git configuration into the container
  // "containerUserEnvModify": {
  //   "git": false
  // },
  "containerEnv": {
  // Tells uv where to store its cache inside the container
    "UV_CACHE_DIR": "/workspace/.uv_cache",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "protocol.ssh.allow",
    "GIT_CONFIG_VALUE_0": "always",
    "SSH_AUTH_SOCK": "/root/.ssh/auth_sock"
    // Forwards the temporary variables created by the initializeCommand below
    // "GIT_AUTHOR_NAME": "${localEnv:HOST_GIT_NAME}",
    // "GIT_AUTHOR_EMAIL": "${localEnv:HOST_GIT_EMAIL}",
    // "GIT_COMMITTER_NAME": "${localEnv:HOST_GIT_NAME}",
    // "GIT_COMMITTER_EMAIL": "${localEnv:HOST_GIT_EMAIL}"
  },

  // 2. Maps your macOS SSH Agent live authentication socket file into the container (Root Path)
  "mounts": [
    "source=/run/host-services/ssh-auth.sock,target=/root/.ssh/auth_sock,type=bind,consistency=cached"
  ]
  // 3. Runs natively on macOS BEFORE building the container to extract Git details
  //"initializeCommand": "export HOST_GIT_NAME=\"$(git config --get user.name)\" && export HOST_GIT_EMAIL=\"$(git config --get user.email)\""
}
